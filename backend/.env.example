# API locale llama.cpp
LLAMA_API_URL=http://127.0.0.1:8080/v1/chat/completions
LLAMA_MODEL=Dolphin3.0-Llama3.1-8B-abliterated.Q4_K_S
MAX_INFERENCES_SIMULTANEES=1

# Limites de l'API
MAX_BODY_SIZE=2000000
REQUETES_PAR_MINUTE=5
QUOTA_TOKENS_PAR_JOUR=10000

# Delais en secondes
LLAMA_CONNECT_TIMEOUT=5
LLAMA_READ_TIMEOUT=120
LLAMA_WRITE_TIMEOUT=10
LLAMA_POOL_TIMEOUT=5

# Base de donnees
# Sans configuration, le backend utilise SQLite local: sqlite+aiosqlite:///./hackmeai.db
# Pour forcer une URL complete:
# DATABASE_URL=mysql+asyncmy://utilisateur:motdepasse@127.0.0.1:3306/HackMeAi?charset=utf8mb4

# Configuration MySQL separee
DB_SERVER=127.0.0.1
DB_PORT=3306
DB_NAME=HackMeAi
DB_USER=<A_RENSEIGNER>
DB_PASSWORD=<A_RENSEIGNER>

# Cle admin utilisee par le header ADMINKEY
ADMIN_API_KEY=<A_RENSEIGNER>
