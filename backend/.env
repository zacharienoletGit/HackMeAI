# Configuration locale de developpement.
# Entre cette valeur dans la page /admin/connexion.
ADMIN_API_KEY=allo

# SQLite local pour demarrer sans serveur MySQL.
DATABASE_URL=sqlite+aiosqlite:///./hackmeai.db

# API locale llama.cpp. Necessaire pour le chat, pas pour creer un utilisateur.
LLAMA_API_URL=http://127.0.0.1:8080/v1/chat/completions
LLAMA_MODEL=Dolphin3.0-Llama3.1-8B-abliterated.Q4_K_S
MAX_INFERENCES_SIMULTANEES=1

MAX_BODY_SIZE=2000000
REQUETES_PAR_MINUTE=5
QUOTA_TOKENS_PAR_JOUR=10000
LLAMA_CONNECT_TIMEOUT=5
LLAMA_READ_TIMEOUT=120
LLAMA_WRITE_TIMEOUT=10
LLAMA_POOL_TIMEOUT=5
